# SERVER
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# DATABASE
DB_HOST=localhost
DB_USER=postgres
DB_PASS=postgres
DB_NAME=chatbot
DB_PORT=5432

DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

DATABASE_URL=postgres://postgres:postgres@db_chatbot:5432/chatbot

# INTERNAL APIs
TELEGRAM_API_URL=http://telegram_bot:3002
WHATSAPP_API_URL=http://chatbot-erp:3000

# INTERNAL ENDPOINTS
SEND_TELEGRAM_MESSAGE_URL=http://telegram_bot:3002/send-message
SEND_WHATSAPP_MESSAGE_URL=http://chatbot-erp:3000/instances

# SOCKET
SOCKET_IO_CORS_ORIGIN=*

# CORS
CORS_ORIGIN=*

# CHATBOT
DEFAULT_FUNIL_ID=1

WEBHOOK_ROUTE=/webhook

DEFAULT_MESSAGE_TYPE=text

MESSAGE_EXPIRATION_MINUTES=10

MAX_MESSAGE_LENGTH=5000

DEFAULT_WEBHOOK_URL=http://api_mensagem:3001/webhook

# REQUESTS / HTTP
REQUEST_TIMEOUT=15000
AXIOS_TIMEOUT=8000

# API ROUTES
WHATSAPP_MESSAGE_ROUTE=/message
TELEGRAM_MESSAGE_ROUTE=/send-message

# UPLOADS / STORAGE
UPLOAD_DIR=/app/uploads
MEDIA_PUBLIC_URL=http://localhost/uploads

AUTH_DIR=/app/auth
QRCODE_DIR=/app/qrcodes

# LOGS
LOG_LEVEL=info

ENABLE_MESSAGE_LOG=true

MAX_LOG_BODY_LENGTH=3000

LOG_USER_EMAIL=false